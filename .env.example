# Local development only. Never commit a populated .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PGlite can use a local path during the credential-free demo.
# For PostgreSQL, replace this locally with a private connection string.
DATABASE_URL=./data/pantry-hold.db

# Keep the deterministic demo on the checked official-response fixture.
OPENFDA_SOURCE_MODE=cached_official_fixture
OPENFDA_FIXTURE_PATH=fixtures/openfda/H-1180-2026.json
