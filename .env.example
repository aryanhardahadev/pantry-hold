# Local development only. Never commit a populated .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# The ordinary dev command runs API + worker in one process against this
# persistent PGlite directory so both use the same credential-free database.
PGLITE_DATA_DIR=.data/pantry-hold

# Production API + worker processes must instead share PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/pantry_hold

# Live openFDA is attempted first; this clearly labelled official fixture is
# the deterministic fallback when the official endpoint is unavailable.
OPENFDA_FIXTURE_PATH=fixtures/openfda/H-1180-2026.json
